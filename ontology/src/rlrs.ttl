@prefix : <http://example.org/rlrs#> .
@prefix rlrs: <http://example.org/rlrs#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix iso19148: <http://iso.org/standard/19148#> .
@prefix ifc: <http://standards.buildingsmart.org/IFC/RELEASE/IFC4_3/ADD2#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .

<http://example.org/rlrs> a owl:Ontology ;
    rdfs:label "RLRS: Railway Linear Referencing System Ontology" ;
    rdfs:comment "A module for the RSM model aligned with ISO 19148, DUL, and IFC 4.3 ADD2." ;
    owl:imports <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> .

### Classes

# ISO 19148: A manner in which measurements are made along a linear element [1].
# DUL: A Description that defines concepts to guide carrying out actions [2].
rlrs:LinearReferencingMethod a owl:Class ;
    rdfs:subClassOf dul:Method ;
    rdfs:label "Linear Referencing Method" ;
    rdfs:comment "Specifies absolute, interpolative, or relative measurement manners [3, 4]." .

# ISO 19148: A set of linear referencing methods and procedures [1].
# DUL: A Description that represents a conceptualization [5].
rlrs:LinearReferencingSystem a owl:Class ;
    rdfs:subClassOf dul:Description ;
    rdfs:label "Linear Referencing System" ;
    rdfs:comment "A system combining a referent, geometry, and interpolation methods [1, 6]." .

# User requirement: ISO 'Referent' corresponds to 'IfcAlignment' and RSM 'LinearLocation'.
# DUL: A Physical Object is spatially located [7, 8].
rlrs:Referent a owl:Class ;
    rdfs:subClassOf dul:PhysicalObject, ifc:IfcAlignment ;
    rdfs:label "Referent" ;
    rdfs:comment "A known location along a linear element; corresponds to IfcAlignment and LinearLocation [9, 10]." .

# ISO 19148: One-dimensional object serving as the axis for measurements [11].
# DUL: Physical Body neutralizing artifactual character [8, 12].
rlrs:LinearElement a owl:Class ;
    rdfs:subClassOf dul:PhysicalBody ;
    rdfs:label "Linear Element" ;
    rdfs:comment "The axis along which measurements are made, such as a track or rail [11, 13]." .

# ISO 19148: The measured value defining a location [14].
# DUL: A Region in a dimensional space used to localize an entity [15, 16].
rlrs:LinearCoordinate a owl:Class ;
    rdfs:subClassOf dul:SpaceRegion ;
    rdfs:label "Linear Coordinate" ;
    rdfs:comment "The measure along the track (e.g., mileage) [15, 17]." .

### Properties

# Link the Referent to the Linear Element it identifies.
rlrs:isReferentOf a owl:ObjectProperty ;
    rdfs:domain rlrs:Referent ;
    rdfs:range rlrs:LinearElement ;
    rdfs:label "is referent of" ;
    rdfs:comment "Relates a known referent location to the linear axis [9]." .

# Associate the LRS with a particular geometry.
rlrs:hasGeometry a owl:ObjectProperty ;
    rdfs:domain rlrs:LinearReferencingSystem ;
    rdfs:range geosparql:Feature ;
    rdfs:label "has geometry" ;
    rdfs:comment "Relates the LRS to its spatial representation [18]." .

# Link the Coordinate to the asset or rolling stock.
rlrs:locatesAsset a owl:ObjectProperty ;
    rdfs:domain rlrs:LinearCoordinate ;
    rdfs:range dul:Object ;
    rdfs:label "locates asset" ;
    rdfs:comment "Relates a coordinate region to a fixed or moving object [7, 19]." .

# Link the LRS to the Method it uses.
rlrs:usesMethod a owl:ObjectProperty ;
    rdfs:subPropertyOf dul:usesConcept ;
    rdfs:domain rlrs:LinearReferencingSystem ;
    rdfs:range rlrs:LinearReferencingMethod ;
    rdfs:label "uses method" ;
    rdfs:comment "The method employed by the LRS for measurement [6, 20]." .
